# ── Local development (default) ──────────────────────────────────────────────
# Leave DATABASE_URL unset and the app uses PGlite automatically — a real
# Postgres engine that runs locally with zero setup and zero cost. Nothing
# below is required just to run `npm run dev`.

# ── Production (Vercel) ───────────────────────────────────────────────────────
# Set these in Vercel's Project Settings → Environment Variables, not in a
# committed file.

# Postgres connection string from Neon's free tier (see README "Deploying to
# Vercel"). Must start with postgres:// or postgresql://.
# DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/procureiq?sslmode=require

# Required by Auth.js in production. Generate your own — never reuse this example:
#   openssl rand -base64 32
# AUTH_SECRET=replace-with-your-own-generated-secret

# The canonical URL of your deployed app (Auth.js uses this for callback URLs
# and cookie settings). On Vercel this can usually be left unset — Vercel sets
# an equivalent automatically — but set it explicitly if you use a custom domain.
# AUTH_URL=https://your-app.vercel.app

# ── AI features (optional) ───────────────────────────────────────────────────
# Powers the "Explain this discrepancy" and "Draft clarification email" buttons.
# Get a key at https://console.anthropic.com (API keys are billed separately
# from a claude.ai subscription — see README "Setting up the AI features").
# Without this set, those two buttons fail with a clear in-app message;
# everything else in the app works normally.
# ANTHROPIC_API_KEY=sk-ant-api03-...
